{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode 2 native dialect. Change per-role model ids in shared/models.yaml
  // and regenerate agents.
  // This top-level model is the fallback for sessions that do not pick an agent model.
  "default_agent": "orchestrator",
  "model": "minimax-coding-plan/MiniMax-M3.1-Flash",
  "update": "disable",
  "experimental": {
    "subagent_depth": 2
  },
  "instructions": [
    "__FORGE_OPENCODE_AGENTS_MD__"
  ],
  // The only Forge plugin: the V2 branch guard. It lives in a package
  // directory because OpenCode 2 requires declared plugin paths to be
  // directories ("configured plugin path must be a directory").
  "plugins": [
    "./plugin-packages/forge-guard"
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.83"]
      }
    }
  },
  "providers": {
    "openai": {
      "env": ["OPENAI_API_KEY"],
      "models": {
        "gpt-6-luna": {
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high", "reasoningSummary": "auto" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh", "reasoningSummary": "auto" } }
          ]
        },
        "gpt-6.1-sol": {
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high", "reasoningSummary": "auto" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh", "reasoningSummary": "auto" } }
          ]
        }
      }
    },
    "anthropic": {
      "env": ["ANTHROPIC_API_KEY"]
    },
    "ollama": {
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
